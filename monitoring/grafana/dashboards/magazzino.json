{
  "uid": "magazzino",
  "title": "Magazzino & Ordini",
  "tags": ["magazzino"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "row", "title": "Disponibilità e target", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}},
    {
      "id": 2, "type": "stat", "title": "Target Prometheus",
      "description": "1 = raggiungibile, 0 = scrape fallito.",
      "gridPos": {"x": 0, "y": 1, "w": 6, "h": 4},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"magazzino\"}", "legendFormat": "{{instance}}", "refId": "A", "instant": true}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {"id": 3, "type": "row", "title": "Richieste HTTP", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}},
    {
      "id": 4, "type": "timeseries", "title": "Richieste HTTP per stato",
      "description": "Richieste al secondo, aggregate per codice di risposta.",
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"magazzino\"}[$__rate_interval]))", "legendFormat": "{{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 5, "type": "timeseries", "title": "Errori HTTP 5xx",
      "description": "Risposte 5xx al secondo; assenza di serie significa nessun errore ancora registrato.",
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(http_server_requests_seconds_count{job=\"magazzino\",status=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "color": {"mode": "fixed", "fixedColor": "red"}}, "overrides": []}
    },
    {
      "id": 6, "type": "timeseries", "title": "Latenza HTTP p95",
      "description": "95° percentile stimato dai bucket histogram delle richieste.",
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"magazzino\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "color": {"mode": "fixed", "fixedColor": "blue"}}, "overrides": []}
    },
    {"id": 7, "type": "row", "title": "JVM", "gridPos": {"x": 0, "y": 13, "w": 24, "h": 1}},
    {
      "id": 8, "type": "timeseries", "title": "Heap JVM",
      "description": "Memoria heap corrente usata e massima; un massimo non definito può non essere disponibile.",
      "gridPos": {"x": 0, "y": 14, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(jvm_memory_used_bytes{job=\"magazzino\",area=\"heap\"})", "legendFormat": "usata", "refId": "A"},
        {"expr": "sum(jvm_memory_max_bytes{job=\"magazzino\",area=\"heap\"} > 0)", "legendFormat": "massima", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 9, "type": "timeseries", "title": "Pause GC",
      "description": "Numero di pause garbage collector al secondo, per causa.",
      "gridPos": {"x": 8, "y": 14, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (cause) (rate(jvm_gc_pause_seconds_count{job=\"magazzino\"}[$__rate_interval]))", "legendFormat": "{{cause}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 10, "type": "timeseries", "title": "Thread JVM",
      "description": "Numero corrente di thread vivi e daemon.",
      "gridPos": {"x": 16, "y": 14, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "jvm_threads_live_threads{job=\"magazzino\"}", "legendFormat": "vivi", "refId": "A"},
        {"expr": "jvm_threads_daemon_threads{job=\"magazzino\"}", "legendFormat": "daemon", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {"id": 11, "type": "row", "title": "Business", "gridPos": {"x": 0, "y": 21, "w": 24, "h": 1}},
    {
      "id": 12, "type": "timeseries", "title": "Ordini per azione",
      "description": "Variazione degli ordini nell'ultima ora per azione, dopo il commit.",
      "gridPos": {"x": 0, "y": 22, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (azione) (increase(magazzino_ordini_total{job=\"magazzino\"}[1h]))", "legendFormat": "{{azione}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 13, "type": "timeseries", "title": "Riassortimenti e pezzi",
      "description": "Riassortimenti e pezzi aggiunti nell'ultima ora, registrati dopo il commit.",
      "gridPos": {"x": 8, "y": 22, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(increase(magazzino_riassortimenti_total{job=\"magazzino\"}[1h]))", "legendFormat": "riassortimenti", "refId": "A"},
        {"expr": "sum(increase(magazzino_riassortimenti_pezzi_total{job=\"magazzino\"}[1h]))", "legendFormat": "pezzi", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 14, "type": "timeseries", "title": "Durata casi d'uso p95",
      "description": "95° percentile stimato dai bucket per operazione.",
      "gridPos": {"x": 16, "y": 22, "w": 8, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, operazione) (rate(magazzino_casi_uso_durata_seconds_bucket{job=\"magazzino\"}[$__rate_interval])))", "legendFormat": "{{operazione}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {"id": 15, "type": "row", "title": "Scorte", "gridPos": {"x": 0, "y": 29, "w": 24, "h": 1}},
    {
      "id": 16, "type": "timeseries", "title": "Prodotti sotto soglia e catalogo",
      "description": "Gauge correnti aggregati, aggiornati ogni 60 secondi; sotto soglia include la soglia stessa.",
      "gridPos": {"x": 0, "y": 30, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "magazzino_prodotti_sotto_scorta{job=\"magazzino\"}", "legendFormat": "sotto soglia", "refId": "A"},
        {"expr": "magazzino_prodotti_totali{job=\"magazzino\"}", "legendFormat": "catalogo", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {"id": 17, "type": "row", "title": "MCP", "gridPos": {"x": 0, "y": 37, "w": 24, "h": 1}},
    {
      "id": 18, "type": "timeseries", "title": "Chiamate MCP per tool ed esito",
      "description": "Chiamate al secondo per tool ed esito; le serie compaiono dopo la prima chiamata.",
      "gridPos": {"x": 0, "y": 38, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum by (strumento, esito) (rate(magazzino_mcp_chiamate_total{job=\"magazzino\"}[$__rate_interval]))", "legendFormat": "{{strumento}} · {{esito}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    },
    {
      "id": 19, "type": "timeseries", "title": "Durata MCP p95 per tool",
      "description": "95° percentile stimato dai bucket histogram per tool.",
      "gridPos": {"x": 12, "y": 38, "w": 12, "h": 7},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, strumento) (rate(magazzino_mcp_durata_seconds_bucket{job=\"magazzino\"}[$__rate_interval])))", "legendFormat": "{{strumento}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "color": {"mode": "palette-classic"}}, "overrides": []}
    }
  ]
}
